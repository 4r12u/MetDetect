{
  "seed": 42,
  "jobs": 2,
  "selection_metric": "malicious_f1",
  "max_trials": 50,
  "top_k": 20,
  "thresholds": {"probability": [0.3, 0.5, 0.7], "decision": [-0.5, 0.0, 0.5]},
  "models": {
    "dt": {"grid": {"max_depth": [4, 8, 12], "min_samples_leaf": [1, 3]}},
    "rf": {"grid": {"n_estimators": [100, 200], "max_depth": [12, null]}},
    "lr": {"grid": {"C": [0.1, 1.0, 10.0]}},
    "svm": {"grid": {"C": [0.1, 1.0, 10.0]}},
    "cnb": {"grid": {"alpha": [0.1, 0.5, 1.0]}},
    "xgb": {"grid": {"n_estimators": [100, 200], "max_depth": [3, 5], "learning_rate": [0.05, 0.1]}}
  }
}
